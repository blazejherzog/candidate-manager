  "info" : {
    "title" : "Candidate Manager API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/applications/{id}" : {
      "get" : {
        "operationId" : "findApplication",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobApplicationDetails"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Error described as RFC 9457 problem details"
          }
        },
        "tags" : [ "job-application-controller" ]
      }
    },
    "/api/applications/{id}/history" : {
      "get" : {
        "operationId" : "findHistory",
        "parameters" : [ {
